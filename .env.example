# LLM Backend Selection for resume-matcher
# Option 1: Google Gemini Free API (Get a free key at https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Option 2: Local Ollama (leave empty if using Gemini)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# Career-Ops High-Comp Job Pipeline Settings
MIN_BASE_SALARY=130000
TARGET_MAX_SALARY=350000
PREFERRED_LOCATIONS=Remote,United States,San Francisco, CA,New York, NY
TARGET_ROLES=Senior Backend Engineer,Distributed Systems Engineer,Staff Software Engineer,Full-Stack Lead

# Outreach Engine & Email Tracking Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
TRACKING_BASE_URL=http://localhost:8085

